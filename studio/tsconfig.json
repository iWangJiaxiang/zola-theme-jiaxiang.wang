{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "noEmit": true, "esModuleInterop": true, "skipLibCheck": true,
    "resolveJsonModule": true, "types": ["node", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "server/**/*.ts", "cloud-functions/**/*.ts", "shared/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "vite.config.ts"]
}
