# Recommended for first use: npm run setup (creates .env without overwriting it).
# Manual setup: copy only when .env does not exist; see docs/setup.md.
# Check with npm run doctor. Never use VITE_ for secrets.
STUDIO_ORIGIN=http://localhost:5173
# Site root relative to studio/, NOT the theme root. Adjust for your checkout.
STUDIO_SITE_ROOT=../../..
STUDIO_STATE=file
STUDIO_STATE_DIR=.state
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STUDIO_SESSION_SECRET=
STUDIO_ADMIN_USER=owner
# Generate interactively: npm run password; keep single quotes around the hash.
STUDIO_ADMIN_PASSWORD_HASH=

# OIDC is optional; password and OIDC may be enabled together.
# Callback: <STUDIO_ORIGIN>/api/auth/oidc/callback
# STUDIO_OIDC_ISSUER=https://identity.example.com/realms/blog
# STUDIO_OIDC_CLIENT_ID=creator-studio
# STUDIO_OIDC_CLIENT_SECRET=
# Stable subject IDs from your identity provider, separated by commas, NOT email addresses.
# STUDIO_OIDC_SUBJECTS=
# STUDIO_OIDC_LABEL=统一身份登录

# Makers: use HTTPS origin, STUDIO_STATE=blob, and a reachable Git repository.
# STUDIO_GIT_URL=https://github.com/owner/blog.git
# STUDIO_GIT_BRANCH=master
# GitHub: x-access-token; CNB: cnb; other hosts follow their Git HTTPS rules.
# STUDIO_GIT_USERNAME=x-access-token
# STUDIO_GIT_TOKEN=
# STUDIO_GIT_AUTHOR=Creator Studio
# STUDIO_GIT_EMAIL=studio@example.com
